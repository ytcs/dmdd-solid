&control
    calculation = 'scf'
    prefix = 'aSiO2_tls_L'
    pseudo_dir = '@PSEUDO@'
    outdir = './'
/
&system
    ibrav = 0
    nat = 216
    ntyp = 2
    ecutwfc = 80
    ecutrho = 320
/
&electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.4
/
ATOMIC_SPECIES
 Si 28.0855 Si_ONCV_PBE-1.2.upf
 O  15.999  O_ONCV_PBE-1.2.upf
CELL_PARAMETERS angstrom
 @CELL_FROM_MLIP_GLASS@
ATOMIC_POSITIONS angstrom
 @POSITIONS_L@
K_POINTS automatic
 1 1 1 0 0 0
