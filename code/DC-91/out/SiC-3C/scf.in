&control
    calculation = 'scf'
    prefix = 'SiC3C'
    pseudo_dir = '/root/pseudo'
    outdir = './'
    tstress = .true.
    tprnfor = .true.
/
&system
    ibrav = 2
    celldm(1) = 8.27946
    nat = 2
    ntyp = 2
    ecutwfc = 90
/
&electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
/
ATOMIC_SPECIES
 Si 28.0855 Si_ONCV_PBE-1.2.upf
 C 12.0107 C_ONCV_PBE-1.2.upf
ATOMIC_POSITIONS crystal
 Si 0.000000 0.000000 0.000000
 C 0.250000 0.250000 0.250000
K_POINTS automatic
10 10 10 0 0 0
