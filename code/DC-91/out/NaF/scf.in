&control
    calculation = 'scf'
    prefix = 'NaF'
    pseudo_dir = '/root/pseudo'
    outdir = './'
    tstress = .true.
    tprnfor = .true.
/
&system
    ibrav = 2
    celldm(1) = 8.88199
    nat = 2
    ntyp = 2
    ecutwfc = 90
/
&electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
/
ATOMIC_SPECIES
 Na 22.98977 Na_ONCV_PBE-1.2.upf
 F 18.9984 F_ONCV_PBE-1.2.upf
ATOMIC_POSITIONS crystal
 Na 0.000000 0.000000 0.000000
 F 0.500000 0.500000 0.500000
K_POINTS automatic
10 10 10 0 0 0
