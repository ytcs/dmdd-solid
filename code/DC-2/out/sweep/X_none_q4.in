&control
 calculation='scf', prefix='X_none_q4', pseudo_dir='/root/pseudo', outdir='./tX_none_q4', verbosity='high', disk_io='none'
/
&system
 ibrav=2, celldm(1)=10.692, nat=2, ntyp=1, ecutwfc=80, ecutfock=160, input_dft='hse', nqx1=4, nqx2=4, nqx3=4, noncolin=.true., lspinorb=.true., nbnd=36, x_gamma_extrapolation=.true., exxdiv_treatment='none'
/
&electrons
 conv_thr=1d-9, mixing_beta=0.5
/
ATOMIC_SPECIES
 Ge 72.630 Ge_ONCV_PBE_FR-1.0.upf
ATOMIC_POSITIONS crystal
 Ge 0 0 0
 Ge .25 .25 .25
K_POINTS automatic
 4 4 4 0 0 0
