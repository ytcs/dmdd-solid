&control
 calculation='scf', prefix='k6q6f160', pseudo_dir='/root/pseudo', outdir='./tk6q6f160', verbosity='high', disk_io='none'
/
&system
 ibrav=2, celldm(1)=10.692, nat=2, ntyp=1, ecutwfc=80, ecutfock=160, input_dft='hse', nqx1=6, nqx2=6, nqx3=6, noncolin=.true., lspinorb=.true., nbnd=36
/
&electrons
 conv_thr=1d-9, mixing_beta=0.5
/
ATOMIC_SPECIES
 Ge 72.630 Ge_ONCV_PBE_FR-1.0.upf
ATOMIC_POSITIONS crystal
 Ge 0 0 0
 Ge .25 .25 .25
K_POINTS automatic
 6 6 6 0 0 0
