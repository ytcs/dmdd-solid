&control
 calculation='scf', prefix='Ge', pseudo_dir='@PS@', outdir='@OUT@', verbosity='high'
/
&system
 ibrav=2, celldm(1)=10.692, nat=2, ntyp=1, ecutwfc=30, ecutfock=60, input_dft='hse', nqx1=2, nqx2=2, nqx3=2, noncolin=.true., lspinorb=.true., nbnd=36
/
&electrons
 conv_thr=1d-9, mixing_beta=0.5
/
ATOMIC_SPECIES
 Ge 72.630 Ge_ONCV_PBE_FR-1.0.upf
ATOMIC_POSITIONS crystal
 Ge 0 0 0
 Ge .25 .25 .25
K_POINTS automatic
 4 4 4 0 0 0
