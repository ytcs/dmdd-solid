&control
    calculation = 'scf'
    prefix = 'Ge'
    pseudo_dir = '/root/pseudo'
    outdir = '/root/run/pilot'
    verbosity = 'high'
/
&system
    ibrav = 2
    celldm(1) = 10.692
    nat = 2
    ntyp = 1
    ecutwfc = 80
    ecutfock = 160
    input_dft = 'hse'
    nqx1 = 4, nqx2 = 4, nqx3 = 4
    noncolin = .true.
    lspinorb = .true.
    nbnd = 48
/
&electrons
    conv_thr = 1.0d-10
    mixing_beta = 0.5
/
ATOMIC_SPECIES
 Ge 72.630 Ge_ONCV_PBE_FR-1.0.upf
ATOMIC_POSITIONS crystal
 Ge 0.00 0.00 0.00
 Ge 0.25 0.25 0.25
K_POINTS automatic
 8 8 8 0 0 0
