@@ -0,0 +1,24 @@
+# Physics-audit tests (R15 CMPMC-AUD). Each test prints value / reference / rel. error
+# lines and exits nonzero if a check fails.
+set(CMPMC_AUDIT_TESTS
+    test_anharmonic_decay
+    test_christoffel
+    test_presets
+    test_rates
+    test_luke_ntl
+    test_charge_misc
+    test_fano_partition
+    test_kaplan
+    test_surface
+    test_headers_compile
+)
+foreach(t ${CMPMC_AUDIT_TESTS})
+    add_executable(${t} ${t}.cpp)
+    target_link_libraries(${t} PRIVATE cmpmc)
+    target_include_directories(${t} PRIVATE ${CMAKE_CURRENT_SOURCE_DIR})
+    if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang")
+        target_compile_options(${t} PRIVATE -O2 -Wall -Wextra)
+    endif()
+    add_test(NAME ${t} COMMAND ${t})
+    set_tests_properties(${t} PROPERTIES TIMEOUT 1800)
+endforeach()
diff --git a/tests/audit_common.hpp b/tests/audit_common.hpp
new file mode 100644
index 0000000..a0a18d6
--- /dev/null
+++ b/tests/audit_common.hpp
@@ -0,0 +1,31 @@
+#pragma once
+// Shared helpers for the CMPMC physics-audit tests (R15 CMPMC-AUD).
+// Each test prints "name value reference rel_err status" lines and returns
+// nonzero if any hard check fails. Define CMPMC_AUDIT_REPORT_ONLY to never fail
+// (used when the same source is compiled against the unpatched 921db93 tree).
+#include <cmath>
+#include <cstdio>
+#include <string>
+
+namespace audit {
+inline int g_fail = 0;
+inline void check(const std::string& name, double val, double ref, double tol_rel, double tol_abs = 0.0) {
+    const double err = std::abs(val - ref);
+    const double rel = (ref != 0.0) ? err / std::abs(ref) : err;
+    const bool ok = (err <= tol_abs) || (rel <= tol_rel);
+    std::printf("%-58s %14.6g %14.6g %10.3g %s\n", name.c_str(), val, ref, rel, ok ? "PASS" : "FAIL");
+    if (!ok) ++g_fail;
+}
+inline void info(const std::string& name, double val) {
+    std::printf("%-58s %14.6g\n", name.c_str(), val);
+}
+inline int result() {
+#ifdef CMPMC_AUDIT_REPORT_ONLY
+    std::printf("# report-only build: %d check(s) failed\n", g_fail);
+    return 0;
+#else
+    std::printf("# %d check(s) failed\n", g_fail);
+    return g_fail ? 1 : 0;
+#endif
+}
+} // namespace audit
diff --git a/tests/test_anharmonic_decay.cpp b/tests/test_anharmonic_decay.cpp
new file mode 100644
index 0000000..8cd1fdf
--- /dev/null
+++ b/tests/test_anharmonic_decay.cpp
@@ -0,0 +1,95 @@
+// Audit test: Tamura/Leman anharmonic L-phonon decay in the isotropic approximation.
+//  (a) daughter angles conserve crystal momentum (k_L = k_1 + k_2) for every allowed x;
+//  (b) daughter energy-fraction distributions sampled from CMPMC's inverse-CDF tables
+//      match Leman, arXiv:1109.1193, Eqs. (9) and (12) [the G4CMP GetLTDecayProb /
+//      GetTTDecayProb forms], integrated independently here;
+//  (c) energy conservation per decay (exact by construction, checked on samples).
+#include "audit_common.hpp"
+#include "cmpmc/lattice.hpp"
+#include <vector>
+
+using namespace cmpmc;
+
+// Leman (9): L -> L' + T, x = E_L'/E_L, d = v_L/v_T, (d-1)/(d+1) < x < 1
+static double leman_lt(double d, double x) {
+    const double a = 1.0 - x * x;
+    const double b = (1.0 + x) * (1.0 + x) - d * d * (1.0 - x) * (1.0 - x);
+    const double c = 1.0 + x * x - d * d * (1.0 - x) * (1.0 - x);
+    return (a * a / (x * x)) * b * c * c;
+}
+// Leman (12): L -> T + T in Leman's variable X = d * E_T1/E_L, (d-1)/2 < X < (d+1)/2;
+// beta, gamma, lambda, mu in units of 1e11 Pa (G4CMPAnharmonicDecay convention).
+static double leman_tt(double d, double X, const CrystalConfig& c) {
+    const double be = c.beta / 1e11, ga = c.gamma / 1e11, la = c.lambda / 1e11, mu = c.mu / 1e11;
+    const double A = 0.5 * (1 - d * d) * (be + la + (1 + d * d) * (ga + mu));
+    const double B = be + la + 2 * d * d * (ga + mu);
+    const double C = be + la + 2 * (ga + mu);
+    const double D = (1 - d * d) * (2 * be + 4 * ga + la + 3 * mu);
+    const double t1 = A + B * d * X - B * X * X;
+    const double t2 = C * X * (d - X) - D / (d - X) * (X - d - (1 - d * d) / (4 * X));
+    return t1 * t1 + t2 * t2;
+}
+
+struct Moments { double m1 = 0, m2 = 0; };
+template <class F>
+static Moments pdf_moments(F&& p, double lo, double hi) {
+    const int N = 200000; double s0 = 0, s1 = 0, s2 = 0; const double dx = (hi - lo) / N;
+    for (int i = 0; i < N; ++i) { const double x = lo + (i + 0.5) * dx; const double w = std::max(0.0, p(x));
+        s0 += w; s1 += w * x; s2 += w * x * x; }
+    return {s1 / s0, s2 / s0 - (s1 / s0) * (s1 / s0)};
+}
+
+static void run(const CrystalConfig& cfg) {
+    const CrystalLattice lat(cfg);
+    const double vL = cfg.v_sound, vT = cfg.v_trans, d = vL / vT;
+    const std::string n = cfg.name;
+
+    // (a) momentum closure. Units: E_L = 1, k = E / v.
+    double worst_lt = 0, worst_tt = 0;
+    for (int i = 1; i < 400; ++i) {
+        const double xl = (d - 1) / (d + 1) + ((1.0 - (d - 1) / (d + 1)) * i) / 400.0;
+        const double tL = lat.theta_L_to_LT(xl), tT = lat.theta_T_from_LT(xl);
+        const double kL = xl / vL, kT = (1 - xl) / vT, k0 = 1 / vL;
+        const double par = kL * std::cos(tL) + kT * std::cos(tT) - k0;
+        const double per = kL * std::sin(tL) - kT * std::sin(tT);
+        worst_lt = std::max(worst_lt, std::hypot(par, per) / k0);
+        const double xt = 0.5 * (1 - 1 / d) + (1 / d) * i / 400.0;
+        const double t1 = lat.theta_TT(xt), t2 = lat.theta_TT(1 - xt);
+        const double k1 = xt / vT, k2 = (1 - xt) / vT;
+        const double par2 = k1 * std::cos(t1) + k2 * std::cos(t2) - k0;
+        const double per2 = k1 * std::sin(t1) - k2 * std::sin(t2);
+        worst_tt = std::max(worst_tt, std::hypot(par2, per2) / k0);
+    }
+    audit::check(n + " L->L'T max |k1+k2-k0|/k0", worst_lt, 0.0, 0.0, 1e-9);
+    audit::check(n + " L->TT  max |k1+k2-k0|/k0", worst_tt, 0.0, 0.0, 1e-9);
+    {
+        const double cth = std::cos(lat.theta_TT(0.5));
+        audit::check(n + " L->TT cos(theta) at x=0.5 (Leman (13): 1/d)", cth, 1.0 / d, 1e-9);
+    }
+
+    // (b) energy-fraction distributions
+    Rng rng(12345);
+    const int NS = 2000000;
+    double s1 = 0, s2 = 0, t1 = 0, t2 = 0, econs = 0;
+    for (int i = 0; i < NS; ++i) {
+        const double x = lat.sample_lt_energy_fraction(rng); s1 += x; s2 += x * x;
+        const double y = lat.sample_tt_energy_fraction(rng); t1 += y; t2 += y * y;
+        const double E = 1.0 + rng.uniform();
+        econs = std::max(econs, std::abs((x * E + (1 - x) * E) - E) / E);
+    }
+    const double mlt = s1 / NS, vlt = s2 / NS - mlt * mlt, mtt = t1 / NS, vtt = t2 / NS - mtt * mtt;
+    const Moments lt = pdf_moments([&](double x) { return leman_lt(d, x); }, (d - 1) / (d + 1), 1.0);
+    const Moments tt = pdf_moments([&](double f) { return leman_tt(d, d * f, cfg); }, 0.5 * (1 - 1 / d), 0.5 * (1 + 1 / d));
+    audit::check(n + " L->L'T <x> vs Leman (9)", mlt, lt.m1, 2e-3);
+    audit::check(n + " L->L'T Var(x) vs Leman (9)", vlt, lt.m2, 2e-2);
+    audit::check(n + " L->TT  <x> vs Leman (12)", mtt, tt.m1, 2e-3);
+    audit::check(n + " L->TT  Var(x) vs Leman (12)", vtt, tt.m2, 2e-2);
+    audit::check(n + " energy conservation per decay", econs, 0.0, 0.0, 1e-14);
+}
+
+int main() {
+    std::printf("# test_anharmonic_decay\n");
+    run(materials::Germanium());
+    run(materials::Silicon());
+    return audit::result();
+}
diff --git a/tests/test_charge_misc.cpp b/tests/test_charge_misc.cpp
new file mode 100644
index 0000000..3c7114f
--- /dev/null
+++ b/tests/test_charge_misc.cpp
@@ -0,0 +1,62 @@
+// Audit test: charge-carrier odds and ends.
+//  (a) Herring-Vogt valley axes follow the crystal orientation: with orient = R the
+//      electron velocity for detector-frame momentum R p must equal R v(p) of the
+//      unrotated crystal;
+//  (b) HV kinematics: E_kin = sum_i p_i^2/(2 m_i) and v = M^-1 p in the valley frame;
+//  (c) intervalley rates: Quadratic and Linear forms (G4CMPIVRateQuadratic/Linear),
+//      Matrix optical rate vs Jacoboni-Reggiani with Z_f = 2N-1 (as implemented) and
+//      the per-phonon final-valley count (reported, not asserted).
+#include "audit_common.hpp"
+#include "cmpmc/lattice.hpp"
+
+using namespace cmpmc;
+
+int main() {
+    std::printf("# test_charge_misc\n");
+    CrystalConfig c0 = materials::Germanium();
+    CrystalConfig c1 = c0; c1.set_miller_orientation(1, 1, 0, 0.3);
+    const CrystalLattice L0(c0), L1(c1);
+    Rng rng(4); double worst = 0;
+    for (int t = 0; t < 1000; ++t) {
+        const Vec3 p = rng.isotropic_dir() * 3.0;      // eV (hbar c k)
+        const size_t iv = t % L0.num_valleys();
+        const Vec3 v0 = L0.map_p_to_vel_electron(iv, p);
+        const Vec3 v1 = L1.map_p_to_vel_electron(iv, c1.orient * p);
+        worst = std::max(worst, (v1 - c1.orient * v0).norm() / v0.norm());
+    }
+    audit::check("Ge e- velocity covariant under crystal rotation (max rel)", worst, 0.0, 0.0, 1e-12);
+
+    // (b) HV kinematics in valley 0 of Ge ([111] axis): p along the valley axis
+    {
+        const Vec3 ax = Vec3{1, 1, 1}.unit();
+        const double p = 2.0; const double mL = c0.e_mass_tensor.x * units::m_e_eV;
+        audit::check("Ge e- E_kin(p || [111]) = p^2/(2 m_l)", L0.map_p_to_ekin_electron(0, ax * p), p * p / (2 * mL), 1e-6);
+        audit::check("Ge e- |v|(p || [111]) = p c/m_l", L0.map_p_to_vel_electron(0, ax * p).norm(), p * units::c_light / mL, 1e-6);
+    }
+    // (c) IV rates
+    {
+        const CrystalConfig& g = c0; const Vec3 E{0, 0, 150.0};
+        const double q = g.iv_quad_rate * std::pow(g.iv_quad_field * g.iv_quad_field + 150.0 * 150.0, 0.5 * g.iv_quad_power);
+        audit::check("Ge IV Quadratic rate at 150 V/m (G4CMP form)", physics::intervalley_scattering_rate(0.02, E, g), q, 1e-12);
+        const CrystalConfig s = materials::Silicon(); const Vec3 Es{0, 0, 2.0e4};
+        const double l = s.iv_lin_rate0 + s.iv_lin_rate1 * std::pow(200.0, s.iv_lin_power);
+        audit::check("Si IV Linear rate at 200 V/cm (G4CMP form)", physics::intervalley_scattering_rate(0.02, Es, s), l, 1e-12);
+        // Matrix optical part: J&R W = Z_f m_d^{3/2} D^2 sqrt(E - hw)(..)/(sqrt2 pi rho hbar^2 hw) (T = 0 emission)
+        CrystalConfig sm = s; sm.iv_model = IVRateModel::Matrix; sm.neutral_impurity_cm3 = 0.0;
+        const double Ek = 0.08;  // eV, above all six Si thresholds
+        const double impl = physics::intervalley_matrix_rate(Ek, sm);
+        // Si: g-type phonons (first three) Z_f = 1, f-type (last three) Z_f = 4 (Jacoboni & Reggiani 1983)
+        CrystalConfig one = sm; one.valley_dirs = {{1,0,0},{0,1,0}};   // 2N-1 = 3 -> rescale below
+        double jr = 0;
+        for (size_t i = 0; i < sm.iv_energy_eV.size(); ++i) {
+            CrystalConfig ci = sm; ci.iv_energy_eV = {sm.iv_energy_eV[i]}; ci.iv_deform_eV_m = {sm.iv_deform_eV_m[i]};
+            const double per = physics::intervalley_matrix_rate(Ek, ci) / 5.0;   // per final valley (2N-1 = 5 for N=3)
+            jr += per * (i < 3 ? 1.0 : 4.0);
+        }
+        audit::info("Si IV Matrix rate impl (1/s) at 80 meV", impl);
+        audit::info("Si IV Matrix rate with J&R Z_f (g:1, f:4)", jr);
+        audit::info("ratio impl / J&R", impl / jr);
+        (void)one;
+    }
+    return audit::result();
+}
diff --git a/tests/test_christoffel.cpp b/tests/test_christoffel.cpp
new file mode 100644
index 0000000..497f95f
--- /dev/null
+++ b/tests/test_christoffel.cpp
@@ -0,0 +1,138 @@
+// Audit test: Christoffel solver and group-velocity lookup tables.
+//  (a) phase velocities along [100], [110], [111] vs the closed cubic forms;
+//  (b) group velocity vs a central finite difference of omega(k) = |k| v_p(k_hat);
+//  (c) error of the bilinear (cos theta, phi) LUT (map_k_to_vg) and of the FP32
+//      octahedral LUT (map_k_to_vg_oct) against the exact solver over random k_hat,
+//      reported as quantiles of the direction error (mrad) and |v_g| error.
+#include "audit_common.hpp"
+#include "cmpmc/lattice.hpp"
+#include <algorithm>
+#include <vector>
+#include <chrono>
+
+using namespace cmpmc;
+
+static void stiff(const CrystalConfig& cfg, double C[3][3][3][3]) {
+    const auto V = cfg.build_voigt_matrix();
+    auto vi = [](int i, int j) { if (i == j) return i; if (i + j == 3) return 3; if (i + j == 2) return 4; return 5; };
+    for (int i = 0; i < 3; ++i) for (int j = 0; j < 3; ++j) for (int l = 0; l < 3; ++l) for (int m = 0; m < 3; ++m)
+        C[i][j][l][m] = V[vi(i, j)][vi(l, m)];
+}
+
+static void exact(const double C[3][3][3][3], double rho, const Vec3& k, Vec3 vg[3], double vp[3]) {
+    physics::solve_christoffel_exact(C, rho, k.unit(), vg, vp);
+}
+
+static void run_cubic(const CrystalConfig& cfg) {
+    double C[3][3][3][3]; stiff(cfg, C);
+    const double r = cfg.density, c11 = cfg.C11, c12 = cfg.C12, c44 = cfg.C44;
+    Vec3 vg[3]; double vp[3];
+    const std::string n = cfg.name;
+    exact(C, r, {1, 0, 0}, vg, vp);
+    audit::check(n + " [100] v_L", vp[0], std::sqrt(c11 / r), 1e-10);
+    audit::check(n + " [100] v_T (FT)", vp[1], std::sqrt(c44 / r), 1e-10);
+    audit::check(n + " [100] v_T (ST)", vp[2], std::sqrt(c44 / r), 1e-10);
+    exact(C, r, {1, 1, 0}, vg, vp);
+    audit::check(n + " [110] v_L", vp[0], std::sqrt((c11 + c12 + 2 * c44) / (2 * r)), 1e-10);
+    const double a = std::sqrt(c44 / r), b = std::sqrt((c11 - c12) / (2 * r));
+    audit::check(n + " [110] v_FT", vp[1], std::max(a, b), 1e-10);
+    audit::check(n + " [110] v_ST", vp[2], std::min(a, b), 1e-10);
+    exact(C, r, {1, 1, 1}, vg, vp);
+    audit::check(n + " [111] v_L", vp[0], std::sqrt((c11 + 2 * c12 + 4 * c44) / (3 * r)), 1e-10);
+    audit::check(n + " [111] v_T", vp[1], std::sqrt((c11 - c12 + c44) / (3 * r)), 1e-10);
+}
+
+static void run_lut(const CrystalConfig& cfg) {
+    double C[3][3][3][3]; stiff(cfg, C);
+    const CrystalLattice lat(cfg);
+    Rng rng(7);
+    const std::string n = cfg.name;
+    // (b) group velocity = grad_k omega (finite differences, h = 1e-6)
+    double worst_fd = 0;
+    for (int t = 0; t < 2000; ++t) {
+        const Vec3 k = rng.isotropic_dir();
+        Vec3 vg[3]; double vp[3]; exact(C, cfg.density, k, vg, vp);
+        for (int m = 0; m < 3; ++m) {
+            Vec3 g{};
+            for (int dmn = 0; dmn < 3; ++dmn) {
+                Vec3 kp = k, km = k; const double h = 1e-6;
+                if (dmn == 0) { kp.x += h; km.x -= h; } else if (dmn == 1) { kp.y += h; km.y -= h; } else { kp.z += h; km.z -= h; }
+                Vec3 a[3], b[3]; double pa[3], pb[3]; exact(C, cfg.density, kp, a, pa); exact(C, cfg.density, km, b, pb);
+                const double w = (kp.norm() * pa[m] - km.norm() * pb[m]) / (2 * h);
+                if (dmn == 0) g.x = w; else if (dmn == 1) g.y = w; else g.z = w;
+            }
+            // skip points within 1e-3 of a degeneracy (gradient undefined there)
+            if (std::abs(vp[1] - vp[2]) < 1e-3 * vp[1] && m > 0) continue;
+            worst_fd = std::max(worst_fd, (g - vg[m]).norm() / vg[m].norm());
+        }
+    }
+    audit::check(n + " v_g vs finite-difference grad omega (max rel)", worst_fd, 0.0, 0.0, 1e-5);
+
+    // (c) LUT errors
+    for (int which = 0; which < 2; ++which) {
+        for (int m = 0; m < 3; ++m) {
+            std::vector<double> ang, mag;
+            int nbad = 0; const int NT = 200000;
+            for (int t = 0; t < NT; ++t) {
+                const Vec3 k = rng.isotropic_dir();
+                Vec3 vg[3]; double vp[3]; exact(C, cfg.density, k, vg, vp);
+                const auto kin = which ? lat.map_k_to_vg_oct(static_cast<PhononMode>(m), k)
+                                       : lat.map_k_to_vg(static_cast<PhononMode>(m), k);
+                const double c = std::clamp(kin.vg_dir.dot(vg[m].unit()), -1.0, 1.0);
+                ang.push_back(std::acos(c) * 1e3);
+                mag.push_back(std::abs(kin.vg_mag - vg[m].norm()) / vg[m].norm());
+                if (ang.back() > 17.45) ++nbad; // > 1 degree
+            }
+            std::sort(ang.begin(), ang.end()); std::sort(mag.begin(), mag.end());
+            const std::string tag = n + (which ? " octLUT " : " map_k_to_vg ") + mode_name(static_cast<PhononMode>(m));
+            audit::info(tag + " dir err median (mrad)", ang[NT / 2]);
+            audit::info(tag + " dir err q99 (mrad)", ang[NT * 99 / 100]);
+            audit::info(tag + " dir err max (mrad)", ang.back());
+            audit::info(tag + " |vg| err q99 (rel)", mag[NT * 99 / 100]);
+            audit::info(tag + " fraction dir err > 1 deg", double(nbad) / NT);
+            if (m == 0) audit::check(tag + " q99 dir err < 5 mrad", ang[NT * 99 / 100], 0.0, 0.0, 5.0);
+        }
+    }
+}
+
+static void timing() {
+    const CrystalLattice lat(materials::Germanium());
+    Rng rng(3); std::vector<Vec3> ks(1 << 20); for (auto& k : ks) k = rng.isotropic_dir();
+    double sink = 0;
+    auto t0 = std::chrono::steady_clock::now();
+    for (const auto& k : ks) sink += lat.map_k_to_vg(PhononMode::FT, k).vg_mag;
+    auto t1 = std::chrono::steady_clock::now();
+    for (const auto& k : ks) sink += lat.map_k_to_vg_oct(PhononMode::FT, k).vg_mag;
+    auto t2 = std::chrono::steady_clock::now();
+    audit::info("ns per map_k_to_vg call", std::chrono::duration<double, std::nano>(t1 - t0).count() / ks.size());
+    audit::info("ns per map_k_to_vg_oct call", std::chrono::duration<double, std::nano>(t2 - t1).count() / ks.size());
+    if (sink == 42.0) std::printf("x");
+}
+
+#ifndef CMPMC_AUDIT_REF
+static void exact_mode() {
+    CrystalLattice lat(materials::Germanium());
+    lat.set_kinematics_mode(CrystalLattice::KinematicsMode::Exact);
+    double C[3][3][3][3]; stiff(lat.config(), C);
+    Rng rng(11); double worst = 0;
+    for (int t = 0; t < 20000; ++t) { const Vec3 k = rng.isotropic_dir(); Vec3 vg[3]; double vp[3];
+        exact(C, lat.config().density, k, vg, vp);
+        worst = std::max(worst, (lat.map_k_to_vg(PhononMode::L, k).vg_dir - vg[0].unit()).norm()); }
+    audit::check("Ge Exact kinematics mode max dir err (rad)", worst, 0.0, 0.0, 1e-9);
+}
+#endif
+
+int main() {
+#ifndef CMPMC_AUDIT_REF
+    exact_mode();
+#endif
+    timing();
+    std::printf("# test_christoffel\n");
+    run_cubic(materials::Germanium());
+    run_cubic(materials::Silicon());
+    run_cubic(materials::GalliumArsenide());
+    run_lut(materials::Germanium());
+    run_lut(materials::Silicon());
+    run_lut(materials::Sapphire());
+    return audit::result();
+}
diff --git a/tests/test_fano_partition.cpp b/tests/test_fano_partition.cpp
new file mode 100644
index 0000000..81b6dee
--- /dev/null
+++ b/tests/test_fano_partition.cpp
@@ -0,0 +1,36 @@
+// Audit test: Fano binomial sampler and the energy partition.
+//  (a) sample_fano_binomial: <N> = n_bar and Var N / n_bar = F for n_bar in [2, 1e4],
+//      F in {0.119, 0.15, 0.30} (Fano's definition, 2004.10709 Eq. (3) [FT]);
+//  (b) partition_deposit energy bookkeeping (campaign WP5-v4 (W4) at zero field:
+//      omega = N_eh E_g + heat, heat = prompt phonons + carrier kinetic energy).
+#include "audit_common.hpp"
+#include "cmpmc/partition.hpp"
+#include <vector>
+
+using namespace cmpmc;
+
+int main() {
+    std::printf("# test_fano_partition\n");
+    Rng rng(77);
+    for (double F : {0.119, 0.15, 0.30}) {
+        for (double nb : {2.0, 3.5, 7.3, 20.0, 100.0, 1.0e4}) {
+            const int NS = 400000; double s = 0, s2 = 0;
+            for (int i = 0; i < NS; ++i) { const double n = double(physics::sample_fano_binomial(nb, F, rng)); s += n; s2 += n * n; }
+            const double m = s / NS, v = s2 / NS - m * m;
+            const std::string tag = "F=" + std::to_string(F).substr(0, 5) + " nbar=" + std::to_string(nb).substr(0, 6);
+            audit::check(tag + " <N>", m, nb, 0.01);
+            audit::check(tag + " Var/<N> = F", v / m, F, 0.05);
+        }
+    }
+    const CrystalLattice lat(materials::Silicon());
+    const EnergyPartition part(lat);
+    PartitionOptions opt; opt.max_sampled_pairs = 1u << 30; opt.max_sampled_phonons = 1u << 30;
+    for (double E : {50.0, 1000.0}) {
+        std::vector<ChargeTrack> q; std::vector<PhononTrack> ph;
+        const auto r = part.partition_deposit(Vec3{0, 0, 0}, 0.0, E, false, q, ph, rng, opt);
+        double eq = 0, ep = 0; for (auto& c : q) eq += c.ekin * c.weight; for (auto& p : ph) ep += p.energy * p.weight;
+        audit::check("Si ER " + std::to_string(int(E)) + " eV: N E_g + E_kin + E_ph = omega (W4)",
+                     r.n_pairs_true * lat.config().bandgap + eq + ep, E, 1e-9);
+    }
+    return audit::result();
+}
