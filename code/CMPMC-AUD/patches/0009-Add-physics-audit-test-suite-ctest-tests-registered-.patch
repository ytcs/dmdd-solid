diff --git a/tests/test_kaplan.cpp b/tests/test_kaplan.cpp
new file mode 100644
index 0000000..af1b281
--- /dev/null
+++ b/tests/test_kaplan.cpp
@@ -0,0 +1,106 @@
+// Audit test: Kaplan thin-film QP cascade (KaplanFilm), its surrogate table, and the
+// 3D Bogoliubov-QP rates (Superconductor3D).
+//  (a) pair-breaking QP-energy sampler and QP phonon-emission sampler vs the Kaplan
+//      densities [E1 E2 + D^2]/sqrt((E1^2 - D^2)(E2^2 - D^2)) and
+//      (E - E')^2 (E' - D^2/E)/sqrt(E'^2 - D^2) (Kaplan PRB 14, 4854 (1976);
+//      campaign WP5-v4 Sec. 5 seed P(E1|omega)), by moments;
+//  (b) pair-breaking efficiency eta_pb = D <N_qp>/Omega (campaign WP5-v4 (W13)) vs
+//      Omega/D in the no-loss limit (thick film, no sub-gap absorption): exact value
+//      2D/Omega for Omega < 4D (WP5-v4 Sec. 5 limits); structure above 4D and the
+//      asymptote (0.57-0.6, 1401.1937 [FT]) are reported;
+//  (c) the film escape model's linear lifetime law tau(Omega) = tau0/(1 + 0.29 (Omega/D - 2))
+//      vs the exact Kaplan pair-breaking rate (Superconductor3D LUT);
+//  (d) KaplanSurrogateLUT vs the full cascade in a re-entry cavity (reflected phonons
+//      return to the film with probability p_ret): collected-energy fraction.
+#include "audit_common.hpp"
+#include "cmpmc/kaplan.hpp"
+#include "cmpmc/physics/superconductor_3d.hpp"
+#include <vector>
+
+using namespace cmpmc;
+
+template <class F> static double mean_pdf(F&& p, double lo, double hi) {
+    // integrate in u with x = lo + (hi - lo) sin^2(pi u / 2) to tame endpoint singularities
+    const int N = 400000; double s0 = 0, s1 = 0;
+    for (int i = 0; i < N; ++i) { const double u = (i + 0.5) / N, sn = std::sin(units::half_pi * u);
+        const double x = lo + (hi - lo) * sn * sn, jac = (hi - lo) * units::pi * sn * std::cos(units::half_pi * u);
+        const double w = p(x) * jac; s0 += w; s1 += w * x; }
+    return s1 / s0;
+}
+
+static double cascade_with_reentry(const KaplanFilm& film, const KaplanSurrogateLUT* lut, double E, double p_ret, Rng& rng) {
+    std::vector<double> todo{E}; double edep = 0; SmallVec<double, 64> refl;
+    while (!todo.empty()) {
+        const double e = todo.back(); todo.pop_back();
+        edep += lut ? lut->absorb_phonon_fast(e, refl, rng) : film.absorb_phonon(e, refl, rng);
+        for (double r : refl) if (rng.uniform() < p_ret) todo.push_back(r);
+    }
+    return edep / E;
+}
+
+int main() {
+    std::printf("# test_kaplan\n");
+    KaplanFilm film = KaplanFilm::aluminum_sensor();
+    const double D = film.gap_energy;
+    Rng rng(31);
+    // (a)
+    for (double W : {2.5, 5.0, 20.0}) {
+        const double Om = W * D; double s = 0; const int NS = 400000;
+        for (int i = 0; i < NS; ++i) s += film.sample_qp_energy(Om, rng);
+        const double ref = mean_pdf([&](double x) { return (x * (Om - x) + D * D) / std::sqrt((x * x - D * D) * ((Om - x) * (Om - x) - D * D)); }, D, Om - D);
+        audit::check("pair-breaking <E1>/D, Omega=" + std::to_string(W).substr(0, 4) + "D", s / NS / D, ref / D, 2e-3);
+        double s2 = 0; for (int i = 0; i < NS; ++i) s2 += film.sample_phonon_energy(Om, rng);
+        const double ref2 = mean_pdf([&](double x) { return (Om - x) * (Om - x) * (x - D * D / Om) / std::sqrt(x * x - D * D); }, D, Om);
+        audit::check("QP emission <Omega_ph>/D, E_qp=" + std::to_string(W).substr(0, 4) + "D", s2 / NS / D, (Om - ref2) / D, 2e-3);
+    }
+    // (b) eta_pb in the no-loss limit
+    KaplanFilm thick = film;
+    thick.film_thickness = 1.0; thick.subgap_absorption = 0.0; thick.keep_all_phonons = false;
+    thick.temperature = 0.0; thick.absorber_eff = 1.0;
+    for (double W : {2.0001, 2.5, 3.0, 3.9, 4.5, 5.0, 6.0, 8.0, 10.0, 20.0, 40.0, 100.0}) {
+        double s = 0; const int NS = (W > 50) ? 20000 : 100000; SmallVec<double, 64> refl;
+        for (int i = 0; i < NS; ++i) s += thick.absorb_phonon(W * D, refl, rng);
+        const double eta = s / NS / (W * D);
+        const std::string tag = "eta_pb no-loss, Omega=" + std::to_string(W).substr(0, 5) + "D";
+        if (W < 4.0) audit::check(tag + " vs 2D/Omega (W13 limit)", eta, 2.0 / W, 2e-3);
+        else audit::info(tag, eta);
+    }
+    // with the default 600 nm Al film (escape on): eta including loss
+    {
+        KaplanFilm f = film; f.subgap_absorption = 0.0; f.keep_all_phonons = false;
+        for (double W : {3.0, 5.0, 10.0, 20.0, 40.0}) {
+            double s = 0; const int NS = 100000; SmallVec<double, 64> refl;
+            for (int i = 0; i < NS; ++i) s += f.absorb_phonon(W * D, refl, rng);
+            audit::info("eta_pb 600 nm Al film (escape on), Omega=" + std::to_string(W).substr(0, 4) + "D", s / NS / (W * D));
+        }
+    }
+    // (c) linear lifetime law vs exact Kaplan pair-breaking rate
+    {
+        CrystalConfig al = materials::AluminumCrystal();
+        const physics::Superconductor3D sc(al);
+        double worst = 0;
+        for (double W : {2.5, 4.0, 10.0, 20.0, 40.0}) {
+            const double exact = sc.phonon_pair_breaking_rate(W * sc.delta_T_eV) * al.sc_tau0_ph_s;
+            const double lin = 1.0 + film.phonon_lifetime_slope * (W - 2.0);
+            audit::info("tau0/tau_pb exact Kaplan, Omega=" + std::to_string(W).substr(0, 4) + "D", exact);
+            audit::info("tau0/tau_pb film linear law, same Omega", lin);
+            worst = std::max(worst, std::abs(lin / exact - 1.0));
+        }
+        audit::info("max |linear law / exact Kaplan - 1| on [2.5, 40] D", worst);
+    }
+    // (d) surrogate vs full cascade with re-entry
+    {
+        KaplanFilm f = film;
+        const KaplanSurrogateLUT lut(f);
+        for (double p_ret : {0.0, 0.9}) {
+            for (double W : {3.0, 6.0, 15.0, 35.0}) {
+                double a = 0, b = 0; const int NS = 50000;
+                for (int i = 0; i < NS; ++i) { a += cascade_with_reentry(f, nullptr, W * D, p_ret, rng);
+                                               b += cascade_with_reentry(f, &lut, W * D, p_ret, rng); }
+                audit::check("surrogate/full collected fraction, p_ret=" + std::to_string(p_ret).substr(0, 3) +
+                             " Omega=" + std::to_string(W).substr(0, 4) + "D", b / NS, a / NS, 0.03);
+            }
+        }
+    }
+    return audit::result();
+}
diff --git a/tests/test_luke_ntl.cpp b/tests/test_luke_ntl.cpp
new file mode 100644
index 0000000..0cd125e
--- /dev/null
+++ b/tests/test_luke_ntl.cpp
@@ -0,0 +1,125 @@
+// Audit test: charge drift and Neganov-Trofimov-Luke (NTL) emission.
+//  (a) l0 = pi hbar^4 rho / (2 m^3 Xi^2) vs Leman 1109.1193 Table II [FT];
+//  (b) implemented emission rate vs the theta-integral of Leman Eq. (22)
+//      P(theta) dtheta = (v/l0)(k/k_s)^2 (cos theta - k_s/k)^2 sin theta dtheta;
+//  (c) sampled emission angle and phonon energy vs the same density;
+//  (d) energy closure per carrier in a uniform field (campaign WP7-E-v3 (E11):
+//      NTL heat = W_bias = e V_b per collected pair; per carrier: sum E_Luke +
+//      E_kin(final) - E_kin(initial) = e E . (r_final - r_initial));
+//  (e) step-size convergence of the NTL phonon spectrum (mean, q90 of E_Luke).
+#include "audit_common.hpp"
+#include "cmpmc/engine.hpp"
+#include <algorithm>
+#include <vector>
+
+using namespace cmpmc;
+
+static void l0_table() {
+    struct R { CrystalConfig c; double le, lh; };
+    for (const auto& r : {R{materials::Silicon(), 16.9e-6, 7.5e-6}, R{materials::Germanium(), 257e-6, 108e-6}}) {
+        const CrystalLattice lat(r.c);
+        audit::check(r.c.name + " l0 electron vs Leman Table II", lat.l0_electron(), r.le, 0.05);
+        audit::check(r.c.name + " l0 hole vs Leman Table II", lat.l0_hole(), r.lh, 0.05);
+    }
+}
+
+static void rate_and_angles(const CrystalConfig& cfg) {
+    const CrystalLattice lat(cfg);
+    const ChargePhysics cp(lat);
+    const double ks = lat.k_sound_hole(), l0 = lat.l0_hole(), v = cfg.v_sound;
+    Rng rng(99);
+    for (double M : {1.5, 2.0, 5.0, 20.0}) {
+        ChargeTrack h = cp.make_charge(ExcitationType::Hole, {0, 0, 0}, {0, 0, 1}, 0.0, 0);
+        h.p_eV = Vec3{0, 0, M * ks * units::hbarc};
+        h.ekin = lat.map_p_to_ekin_hole(h.p_eV);
+        // theta integral of Leman (22)
+        const int N = 200000; double s = 0; const double th_max = std::acos(1.0 / M);
+        for (int i = 0; i < N; ++i) { const double th = (i + 0.5) * th_max / N;
+            const double c = std::cos(th) - 1.0 / M; s += (v / l0) * M * M * c * c * std::sin(th) * th_max / N; }
+        const std::string n = cfg.name + " hole M=" + std::to_string(M).substr(0, 4);
+        audit::check(n + " rate impl vs int Leman (22)", cp.luke_emission_rate(h), s, 1e-4);
+        audit::info(n + " ratio to Leman (21) [(M-1)^3/M^2 form]", cp.luke_emission_rate(h) / ((v / (3 * l0)) * std::pow(M - 1, 3) / (M * M)));
+        // sampled cos(theta) and phonon energy
+        double sc = 0, se = 0; const int NS = 400000;
+        for (int i = 0; i < NS; ++i) { ChargeTrack t = h; const auto e = cp.emit_luke_phonon(t, rng);
+            if (!e.emitted) continue; sc += e.q_dir.dot(Vec3{0, 0, 1}); se += e.phonon_eV; }
+        // reference moments of p(c) ~ (c - 1/M)^2 on [1/M, 1]: <c> = 1/M + (3/4)(1 - 1/M)
+        const double a = 1.0 / M, mc = a + 0.75 * (1 - a);
+        // E_ph = hbar v q, q = 2 k (c - 1/M): <E> = hbar v 2 k (3/4)(1 - 1/M)
+        const double me = units::hbar_Planck * v * 2.0 * M * ks * 0.75 * (1 - a);
+        audit::check(n + " <cos theta_q> vs Leman (22)", sc / NS, mc, 2e-3);
+        audit::check(n + " <E_phonon> vs Leman (22)", se / NS, me, 2e-3);
+    }
+}
+
+struct DriftResult { double closure_worst = 0, e_mean = 0, e_q90 = 0, n_ph_per_carrier = 0; };
+
+static DriftResult drift(const CrystalConfig& cfg, ExcitationType type, double E_Vm, double thick, int ncar,
+                         double dk_frac) {
+    const CrystalLattice lat(cfg);
+    DetectorModel det;
+    det.solid.radius = 5.0 * units::cm;
+    det.solid.half_z = 0.5 * thick;
+    det.e_field = UniformElectricField{{0.0, 0.0, -E_Vm}};
+    det.surfaces[0].prob_charge_abs = 1.0; det.surfaces[1].prob_charge_abs = 1.0; det.surfaces[2].prob_charge_abs = 1.0;
+#ifndef CMPMC_AUDIT_REF
+    det.charge_max_dk_frac = dk_frac;
+#else
+    (void)dk_frac;
+#endif
+    const SimulationEngine eng(lat, det);
+    const ChargePhysics cp(lat);
+    Rng rng(2024);
+    DriftResult R; std::vector<double> eph;
+    const double z0 = (type == ExcitationType::Electron) ? -0.49 * thick : 0.49 * thick;
+    for (int c = 0; c < ncar; ++c) {
+        std::vector<ChargeTrack> cs{cp.make_charge(type, {0, 0, z0}, rng.isotropic_dir(), 1e-6, c % std::max<size_t>(1, lat.num_valleys()))};
+        std::vector<PhononTrack> ph; std::vector<SensorHit> hits; SimStats st;
+        eng.transport_charges(cs, ph, hits, st, rng);
+        if (hits.empty()) continue;
+        const double ek_f = hits[0].incident_energy - 0.5 * cfg.bandgap;
+        const double sgn = (type == ExcitationType::Electron) ? -1.0 : 1.0;
+        const double work = sgn * (det.e_field.field_Vm.dot(hits[0].pos - Vec3{0, 0, z0}));
+        R.closure_worst = std::max(R.closure_worst, std::abs(st.total_luke_phonon_eV + ek_f - 1e-6 - work) / work);
+        for (const auto& p : ph) eph.push_back(p.energy);
+        R.n_ph_per_carrier += double(ph.size()) / ncar;
+    }
+    std::sort(eph.begin(), eph.end());
+    double s = 0; for (double e : eph) s += e;
+    R.e_mean = eph.empty() ? 0 : s / eph.size();
+    R.e_q90 = eph.empty() ? 0 : eph[eph.size() * 9 / 10];
+    return R;
+}
+
+int main() {
+    std::printf("# test_luke_ntl\n");
+    l0_table();
+    rate_and_angles(materials::Germanium());
+    rate_and_angles(materials::Silicon());
+    for (const auto& cfg : {materials::Germanium(), materials::Silicon()}) {
+        for (auto type : {ExcitationType::Electron, ExcitationType::Hole}) {
+            for (double E : {100.0, 1000.0, 1.0e4}) {   // V/m (1, 10, 100 V/cm)
+                const std::string n = cfg.name + (type == ExcitationType::Electron ? " e- " : " h+ ") +
+                                      "E=" + std::to_string(int(E)) + "V/m";
+                const double thick = 1e-3;
+                const DriftResult coarse = drift(cfg, type, E, thick, 20, 0.0);
+#ifdef CMPMC_AUDIT_REF
+                audit::check(n + " (E11) closure, legacy step", coarse.closure_worst, 0.0, 0.0, 1e-3);
+#else
+                audit::info(n + " (E11) closure error, legacy step (charge_max_dk_frac = 0)", coarse.closure_worst);
+#endif
+                audit::info(n + " <E_Luke> meV, legacy step", coarse.e_mean * 1e3);
+                audit::info(n + " q90 E_Luke meV, legacy step", coarse.e_q90 * 1e3);
+#ifndef CMPMC_AUDIT_REF
+                const DriftResult fine = drift(cfg, type, E, thick, 20, 0.05);
+                const DriftResult finer = drift(cfg, type, E, thick, 20, 0.02);
+                audit::check(n + " (E11) closure, dk-limited step", fine.closure_worst, 0.0, 0.0, 1e-3);
+                audit::info(n + " <E_Luke> meV, dk <= 0.05 k_s", fine.e_mean * 1e3);
+                audit::info(n + " q90 E_Luke meV, dk <= 0.05 k_s", fine.e_q90 * 1e3);
+                audit::check(n + " <E_Luke> converged (0.05 vs 0.02 k_s, 5%)", fine.e_mean, finer.e_mean, 0.05);
+#endif
+            }
+        }
+    }
+    return audit::result();
+}
diff --git a/tests/test_presets.cpp b/tests/test_presets.cpp
new file mode 100644
index 0000000..cb14cbb
--- /dev/null
+++ b/tests/test_presets.cpp
@@ -0,0 +1,95 @@
+// Audit test: material presets.
+//  (a) every phonon/charge constant of the presets vs G4CMP CrystalMaps/<mat>/config.txt
+//      (the port claim), read with CMPMC's own load_g4cmp_config_file; skipped if the
+//      G4CMP tree is absent (set G4CMP_CRYSTALMAPS);
+//  (b) isotope constant B rebuilt independently, B = 4 pi^3 Gamma_md Omega <v^-3>,
+//      <v^-3> = (1/3) sum_modes <v_p^-3>_{4pi} from CMPMC's own Christoffel solver and
+//      Gamma_md from IUPAC isotope abundances (2408.04732 Eqs. (4)-(9) [FT]);
+//  (c) campaign values: Si eps_eh, F_eh (WP5-v4 Sec. 6.4: 3.749 eV, 0.119 at 5.9 keV),
+//      Debye (max optical) frequencies (2408.04732 Table 5 [FT]: Si 15.28, Ge 9.02,
+//      GaAs 8.58 THz), GaAs A, F_TT (2408.04732 Table 3).
+#include "audit_common.hpp"
+#include "cmpmc/lattice.hpp"
+#include "cmpmc/materials/config_reader.hpp"
+#include <cstdlib>
+#include <filesystem>
+#include <vector>
+
+using namespace cmpmc;
+
+static void cmp_g4cmp(const CrystalConfig& p, const std::string& dir) {
+    const std::string f = dir + "/" + p.name + "/config.txt";
+    if (!std::filesystem::exists(f)) { std::printf("# skip %s (no %s)\n", p.name.c_str(), f.c_str()); return; }
+    const CrystalConfig g = materials::load_g4cmp_config_file(f, p.density, p.name);
+    const std::string n = p.name + " preset vs G4CMP config: ";
+    const auto Vp = p.build_voigt_matrix(), Vg = g.build_voigt_matrix();
+    double dv = 0, vmax = 0;
+    for (int i = 0; i < 6; ++i) for (int j = 0; j < 6; ++j) { dv = std::max(dv, std::abs(Vp[i][j] - Vg[i][j])); vmax = std::max(vmax, std::abs(Vg[i][j])); }
+    audit::check(n + "max |C_ij - C_ij(G4CMP)| / max C", dv / vmax, 0.0, 0.0, 1e-6);
+    audit::check(n + "B_iso", p.B_iso, g.B_iso, 1e-6, 1e-60);
+    audit::check(n + "A_anh", p.A_anh, g.A_anh, 1e-6);
+    audit::check(n + "fTT", p.fTT_frac, g.fTT_frac, 1e-6);
+    audit::check(n + "LDOS", p.fLDOS, g.fLDOS, 1e-6);
+    audit::info(n + "Debye (preset; G4CMP value next line)", p.debye_freq);
+    audit::info(n + "Debye (G4CMP; deliberate deviation for Ge, GaAs)", g.debye_freq);
+    audit::check(n + "v_L", p.v_sound, g.v_sound, 1e-6);
+    audit::check(n + "v_T", p.v_trans, g.v_trans, 1e-6);
+}
+
+struct Iso { double m, f; };
+static double gamma_md(const std::vector<std::vector<Iso>>& sites) {
+    // 2408.04732 Eqs. (5)-(9) with equal stoichiometry per listed site
+    double Mbar = 0, dM2 = 0;
+    for (const auto& s : sites) { double Mn = 0; for (auto i : s) Mn += i.f * i.m;
+        double d = 0; for (auto i : s) d += i.f * (i.m - Mn) * (i.m - Mn); Mbar += Mn; dM2 += d; }
+    Mbar /= sites.size(); dM2 /= sites.size();
+    return dM2 / (Mbar * Mbar);
+}
+
+static double v3inv(const CrystalConfig& cfg) {
+    const auto V = cfg.build_voigt_matrix(); double C[3][3][3][3];
+    auto vi = [](int i, int j) { if (i == j) return i; if (i + j == 3) return 3; if (i + j == 2) return 4; return 5; };
+    for (int i = 0; i < 3; ++i) for (int j = 0; j < 3; ++j) for (int l = 0; l < 3; ++l) for (int m = 0; m < 3; ++m)
+        C[i][j][l][m] = V[vi(i, j)][vi(l, m)];
+    Rng rng(5); double s = 0; const int N = 400000;
+    for (int t = 0; t < N; ++t) { Vec3 vg[3]; double vp[3];
+        physics::solve_christoffel_exact(C, cfg.density, rng.isotropic_dir(), vg, vp);
+        for (int m = 0; m < 3; ++m) s += 1.0 / (vp[m] * vp[m] * vp[m]); }
+    return s / (3.0 * N);
+}
+
+int main() {
+    std::printf("# test_presets\n");
+    const char* env = std::getenv("G4CMP_CRYSTALMAPS");
+    const std::string dir = env ? env : "/home/user/ytcs/G4CMP-ref/CrystalMaps";
+    for (const auto& c : {materials::Germanium(), materials::Silicon(), materials::Sapphire(),
+                          materials::CalciumTungstate(), materials::GalliumArsenide(),
+                          materials::LithiumFluoride(), materials::CalciumFluoride(),
+                          materials::AluminumCrystal(), materials::NiobiumCrystal()})
+        cmp_g4cmp(c, dir);
+
+    const double pi3 = units::pi * units::pi * units::pi;
+    // IUPAC 2013 representative abundances and atomic masses (u)
+    const std::vector<Iso> Si = {{27.97693, 0.92223}, {28.97649, 0.04685}, {29.97377, 0.03092}};
+    const std::vector<Iso> Ge = {{69.92425, 0.2057}, {71.92208, 0.2745}, {72.92346, 0.0775},
+                                 {73.92118, 0.3650}, {75.92140, 0.0773}};
+    const std::vector<Iso> Ga = {{68.92557, 0.60108}, {70.92470, 0.39892}};
+    const std::vector<Iso> As = {{74.92160, 1.0}};
+    struct Case { CrystalConfig c; double a; std::vector<std::vector<Iso>> s; };
+    for (auto& k : {Case{materials::Silicon(), 5.431e-10, {Si}}, Case{materials::Germanium(), 5.658e-10, {Ge}},
+                    Case{materials::GalliumArsenide(), 5.653e-10, {Ga, As}}}) {
+        const double g = gamma_md(k.s), Om = k.a * k.a * k.a / 8.0, B = 4 * pi3 * g * Om * v3inv(k.c);
+        audit::info(k.c.name + " Gamma_md (independent)", g);
+        audit::check(k.c.name + " B_iso preset vs 4pi^3 Gamma Omega <v^-3>", k.c.B_iso, B, 0.10);
+    }
+
+    const auto si = materials::Silicon(), ge = materials::Germanium(), ga = materials::GalliumArsenide();
+    audit::check("Si pair energy vs campaign 3.749 eV (WP5-v4 6.4)", si.pair_energy, 3.749, 0.005);
+    audit::check("Si Fano vs campaign 0.119 (WP5-v4 6.4)", si.fano_factor, 0.119, 0.05);
+    audit::check("Si Debye (THz) vs 2408.04732 T5 15.28", si.debye_freq / units::THz, 15.28, 0.03);
+    audit::check("Ge Debye (THz) vs campaign 8.64 (WP8-R T1.1)", ge.debye_freq / units::THz, 8.64, 0.01);
+    audit::check("GaAs Debye (THz) vs 2408.04732 T5 8.58", ga.debye_freq / units::THz, 8.58, 0.05);
+    audit::check("GaAs A_anh vs 2408.04732 T3 7.77e-55", ga.A_anh, 7.77e-55, 0.02);
+    audit::check("GaAs F_TT vs 2408.04732 T3 0.77", ga.fTT_frac, 0.77, 0.02);
+    return audit::result();
+}
