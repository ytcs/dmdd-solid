From 69252ee08af932bae0055c6adbd93fdda8539441 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Sun, 1 Nov 2026 10:28:10 +0000
Subject: [PATCH 5/9] Charge drift: limit field-driven wavevector change per
 step (NTL spectrum, E11 closure)

transport_charges sampled the Luke/IV/trap rates at the start of a step and
capped the step at a fixed 100 ps. Below threshold (k < k_s, zero Luke rate)
the carrier therefore took 100 ps steps; at 100 V/cm this is dk ~ 100 k_s, so
carriers overshot the Cherenkov threshold, and the emitted NTL phonons were too
hard: mean E_Luke 6.70 vs 4.62 meV (Si e-), 7.40 vs 5.28 meV (Si h+), 4.98 vs
4.68 meV (Ge e-) at 1e4 V/m, and the per-carrier energy closure
sum E_Luke + dE_kin = e E.dr (campaign WP7-E-v3 (E11)) failed by up to 1.2%.
Leman 1109.1193 Sec. V.D [FT] requires steps over which the rate is ~constant.
New DetectorModel::charge_max_dk_frac (default 0.05) bounds |dk| per step to
0.05 max(k_s, |k|) (HV frame for electrons, via CrystalLattice::hv_max_scale);
0 restores the legacy cap (charge_dt_cap_s, default 100 ps). Closure is now
< 6e-5 and <E_Luke> is converged to < 3% (0.05 vs 0.02). The step-loop cap is
raised to 2e7 accordingly. Test: tests/test_luke_ntl.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BcNoovRae5kkbL36KL3sYy
---
 include/cmpmc/engine.hpp  | 22 ++++++++++++++++++++--
 include/cmpmc/lattice.hpp |  2 ++
 2 files changed, 22 insertions(+), 2 deletions(-)

diff --git a/include/cmpmc/engine.hpp b/include/cmpmc/engine.hpp
index c7e6d49..150370a 100644
--- a/include/cmpmc/engine.hpp
+++ b/include/cmpmc/engine.hpp
@@ -94,6 +94,12 @@ struct DetectorModel {
     uint32_t max_bounces       = 5000;
     double min_phonon_eV       = 10.0 * units::ueV; // Cutoff below 2*Delta_W
     double luke_sample_fraction= 1.0;               // Fraction of Luke phonons tracked (with weight = 1/frac)
+    // Charge step control: the field may change the carrier wavevector by at most
+    // charge_max_dk_frac * max(k_s, |k|) per step (HV frame for electrons), so that the
+    // Luke rate (v/3l0)(M-1)^3/M sampled at the start of a step stays ~constant over it
+    // (Leman 1109.1193 Sec. V.D). 0 restores the legacy fixed 100 ps cap.
+    double charge_max_dk_frac  = 0.05;
+    double charge_dt_cap_s     = 100.0 * units::ps;
 
     // Tier-4 Algorithmic Physics Shortcuts (optional, disabled by default)
     physics::JumpToBallisticConfig jump_to_ballistic{};
@@ -148,7 +154,7 @@ public:
 
             const double q_sign = (trk.type == ExcitationType::Electron) ? -1.0 : +1.0;
 
-            for (uint32_t step = 0; step < 500'000; ++step) {
+            for (uint32_t step = 0; step < 20'000'000; ++step) {
                 stats.charge_steps++;
 
                 const Vec3 E_Vm = detector_.electric_field_at(trk.pos);
@@ -164,7 +170,19 @@ public:
                 const double r_ion_h = physics::trap_ionization_h_rate(trk.type, v_cur_mag, lattice_.config());
                 const double r_tot   = r_luke + r_iv + r_trap + r_ion_e + r_ion_h;
 
-                const double dt_max_accel = 100.0 * units::ps;
+                double dt_max_accel = detector_.charge_dt_cap_s;
+                if (detector_.charge_max_dk_frac > 0.0) {
+                    const bool is_e = (trk.type == ExcitationType::Electron);
+                    const double ks = is_e ? lattice_.k_sound_electron() : lattice_.k_sound_hole();
+                    const double k_now = is_e
+                        ? lattice_.ellipsoidal_to_spherical(trk.valley, trk.p_eV / units::hbarc).norm()
+                        : trk.p_eV.norm() / units::hbarc;
+                    const double dk_rate = E_Vm.norm() * units::c_light / units::hbarc *
+                                           (is_e ? lattice_.hv_max_scale() : 1.0);   // |dk/dt| bound [1/(m s)]
+                    if (dk_rate > 0.0)
+                        dt_max_accel = std::min(dt_max_accel,
+                                                detector_.charge_max_dk_frac * std::max(ks, k_now) / dk_rate);
+                }
                 const double dt_phys = (r_tot > 1.0)
                     ? (-std::log(rng.uniform()) / r_tot)
                     : std::numeric_limits<double>::infinity();
diff --git a/include/cmpmc/lattice.hpp b/include/cmpmc/lattice.hpp
index 0c43f04..69a3de6 100644
--- a/include/cmpmc/lattice.hpp
+++ b/include/cmpmc/lattice.hpp
@@ -231,6 +231,8 @@ public:
     double l0_hole() const noexcept { return l0_h_; }
     double k_sound_electron() const noexcept { return k_sound_e_; }
     double k_sound_hole() const noexcept { return k_sound_h_; }
+    // Largest stretch factor of the Herring-Vogt map k -> k* (sqrt(m_c / m_min))
+    double hv_max_scale() const noexcept { return std::max({hv_sqrt_inv_.x, hv_sqrt_inv_.y, hv_sqrt_inv_.z}); }
 
     inline Vec3 rotate_to_valley(size_t iv, const Vec3& v) const noexcept {
         return valley_rot_[iv] * v;
