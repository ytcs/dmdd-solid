&control
    calculation = 'scf'
    prefix = 'GaAs'
    pseudo_dir = '@PSEUDO@'
    outdir = './'
/
&system
    ibrav = 2
    celldm(1) = 10.6829
    nat = 2
    ntyp = 2
    ecutwfc = 90
    noncolin = .true.
    lspinorb = .true.
/
&electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.5
/
ATOMIC_SPECIES
 Ga 69.723 Ga_ONCV_PBE_FR-1.0.upf
 As 74.9216 As_ONCV_PBE_FR-1.1.upf
ATOMIC_POSITIONS crystal
 Ga 0.00 0.00 0.00
 As 0.25 0.25 0.25
K_POINTS automatic
8 8 8 0 0 0
