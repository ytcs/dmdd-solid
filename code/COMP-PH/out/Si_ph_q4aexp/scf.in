&control
  calculation='scf', prefix='Si', outdir='/root/work/COMP-PH/Si/ph_q4aexp', pseudo_dir='/root/pseudo/sg15', tprnfor=.true., tstress=.true.
/
&system
  ibrav=2, celldm(1)=10.263, nat=2, ntyp=1, ecutwfc=60
/
&electrons
  conv_thr=1.0d-12, mixing_beta=0.7
/
ATOMIC_SPECIES
