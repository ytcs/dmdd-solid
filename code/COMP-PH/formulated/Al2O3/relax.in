&control
    calculation = 'vc-relax'
    prefix = 'Al2O3'
    pseudo_dir = '@PSEUDO@'
    outdir = './'
    tstress = .true.
    tprnfor = .true.
/
&system
    ibrav = 5
    celldm(1) = 9.6905, celldm(4) = 0.5697
    nat = 10
    ntyp = 2
    ecutwfc = 100
/
&electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
/
&ions
/
&cell
    press_conv_thr = 0.05
/
ATOMIC_SPECIES
 Al 26.98154 Al_ONCV_PBE-1.2.upf
 O 15.999 O_ONCV_PBE-1.2.upf
ATOMIC_POSITIONS crystal
 Al 0.352000 0.352000 0.352000
 Al 0.648000 0.648000 0.648000
 Al 0.852000 0.852000 0.852000
 Al 0.148000 0.148000 0.148000
 O 0.556000 -0.056000 0.250000
 O -0.056000 0.250000 0.556000
 O 0.250000 0.556000 -0.056000
 O 0.444000 1.056000 0.750000
 O 1.056000 0.750000 0.444000
 O 0.750000 0.444000 1.056000
K_POINTS automatic
6 6 6 0 0 0
