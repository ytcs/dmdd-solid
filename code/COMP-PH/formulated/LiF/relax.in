&control
    calculation = 'vc-relax'
    prefix = 'LiF'
    pseudo_dir = '@PSEUDO@'
    outdir = './'
    tstress = .true.
    tprnfor = .true.
/
&system
    ibrav = 2
    celldm(1) = 7.609
    nat = 2
    ntyp = 2
    ecutwfc = 90
/
&electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
/
&ions
/
&cell
    press_conv_thr = 0.05
/
ATOMIC_SPECIES
 Li 6.94 Li_ONCV_PBE-1.2.upf
 F 18.9984 F_ONCV_PBE-1.2.upf
ATOMIC_POSITIONS crystal
 Li 0.000000 0.000000 0.000000
 F 0.500000 0.500000 0.500000
K_POINTS automatic
10 10 10 0 0 0
