&control
    calculation = 'vc-relax'
    prefix = 'SiC4H'
    pseudo_dir = '@PSEUDO@'
    outdir = './'
    tstress = .true.
    tprnfor = .true.
/
&system
    ibrav = 4
    celldm(1) = 5.8071, celldm(3) = 3.2714
    nat = 8
    ntyp = 2
    ecutwfc = 90
/
&electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
/
&ions
/
&cell
    press_conv_thr = 0.05
/
ATOMIC_SPECIES
 Si 28.0855 Si_ONCV_PBE-1.2.upf
 C 12.0107 C_ONCV_PBE-1.2.upf
ATOMIC_POSITIONS crystal
 Si 0.000000 0.000000 0.000000
 Si 0.333333 0.666667 0.250000
 Si 0.000000 0.000000 0.500000
 Si 0.666667 0.333333 0.750000
 C 0.000000 0.000000 0.187500
 C 0.333333 0.666667 0.437500
 C 0.000000 0.000000 0.687500
 C 0.666667 0.333333 0.937500
K_POINTS automatic
8 8 2 0 0 0
