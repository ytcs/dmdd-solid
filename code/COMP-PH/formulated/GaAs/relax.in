&control
    calculation = 'vc-relax'
    prefix = 'GaAs'
    pseudo_dir = '@PSEUDO@'
    outdir = './'
    tstress = .true.
    tprnfor = .true.
/
&system
    ibrav = 2
    celldm(1) = 10.683
    nat = 2
    ntyp = 2
    ecutwfc = 140
/
&electrons
    conv_thr = 1.0d-12
    mixing_beta = 0.7
/
&ions
/
&cell
    press_conv_thr = 0.05
/
ATOMIC_SPECIES
 Ga 69.723 Ga_ONCV_PBE-1.2.upf
 As 74.9216 As_ONCV_PBE-1.2.upf
ATOMIC_POSITIONS crystal
 Ga 0.000000 0.000000 0.000000
 As 0.250000 0.250000 0.250000
K_POINTS automatic
10 10 10 0 0 0
