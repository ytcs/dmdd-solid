&control
    calculation = 'scf'
    prefix = 'ge'
    pseudo_dir = '@PSEUDO@'
    outdir = './'
/
&system
    ibrav = 2
    celldm(1) = 10.6923
    nat = 2
    ntyp = 1
    noncolin = .true.
    lspinorb = .true.
    ecutwfc = 60
/
&electrons
    conv_thr = 1.0d-13
/
ATOMIC_SPECIES
 Ge 72.630 Ge_ONCV_PBE_FR-1.0.upf
ATOMIC_POSITIONS alat
 Ge 0.00 0.00 0.00
 Ge 0.25 0.25 0.25
K_POINTS automatic
 12 12 12 0 0 0
