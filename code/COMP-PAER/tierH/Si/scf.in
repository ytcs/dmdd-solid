&control
    calculation = 'scf'
    prefix = 'si'
    pseudo_dir = '@PSEUDO@'
    outdir = './'
/
&system
    ibrav = 2
    celldm(1) = 10.2631
    nat = 2
    ntyp = 1
    ecutwfc = 60
/
&electrons
    conv_thr = 1.0d-13
/
