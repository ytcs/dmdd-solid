&control
 calculation='scf', prefix='a', pseudo_dir='/home/ytc/paer-work/pseudo/dojo-fr/nc-fr-04_pbe_standard', outdir='./k8e80', verbosity='high'
/
&system
 ibrav=2, celldm(1)=10.692, nat=2, ntyp=1, ecutwfc=80, noncolin=.true., lspinorb=.true., nbnd=36
/
&electrons
 conv_thr=1d-9, mixing_beta=0.4 , startingpot='file'
/
ATOMIC_SPECIES
 Ge 72.630 Ge.upf
ATOMIC_POSITIONS crystal
 Ge 0 0 0
 Ge .25 .25 .25
K_POINTS automatic
 8 8 8 0 0 0
HUBBARD ortho-atomic
U Ge-4s 1.0d-8
ALPHA Ge-4s 1.0
